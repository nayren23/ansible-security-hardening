#!/usr/sbin/nft -f
# Managed by Ansible. Manual changes will be overwritten.

flush ruleset

define wan_if = "{{ firewall_wan_interface }}"
define lan_ifaces = { {% for interface in firewall_internal_interfaces %}"{{ interface }}"{% if not loop.last %}, {% endif %}{% endfor %} }
define internal_nets = { {{ firewall_internal_networks | join(', ') }} }
define ansible_ip = {{ firewall_ansible_controller_ip }}
define dns_ip = {{ firewall_dns_server_ip }}
define rsyslog_ip = {{ firewall_rsyslog_server_ip }}
define web_ip = {{ firewall_web_server_ip }}
define critical_servers = { {{ firewall_critical_server_ips | join(', ') }} }
define nfs_ip = {{ firewall_nfs_server_ip }}

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state invalid drop
    ct state established,related accept

    # Only the Ansible controller may administer the firewall over SSH.
    ip saddr $ansible_ip tcp dport 22 ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT SSH "
    ip saddr $ansible_ip tcp dport 22 accept

    # DHCP relay receives client requests and server replies locally.
    iifname $lan_ifaces udp sport 68 udp dport 67 accept
    ip saddr 192.168.10.1 udp sport 67 udp dport 67 accept

    # Diagnostic ICMP from internal networks.
    iifname $lan_ifaces ip saddr $internal_nets ip protocol icmp accept

    iifname $lan_ifaces limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_REJECT INPUT "
    iifname $lan_ifaces reject with icmpx type admin-prohibited

    limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_DROP INPUT "
    drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    ct state invalid drop
    ct state established,related accept

    # Only the Ansible controller may administer internal hosts over SSH.
    ip saddr $ansible_ip ip daddr $internal_nets tcp dport 22 ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT SSH "
    ip saddr $ansible_ip ip daddr $internal_nets tcp dport 22 accept

    # DNS queries to the internal resolver.
    ip saddr $internal_nets ip daddr $dns_ip meta l4proto { tcp, udp } th dport 53 ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT DNS "
    ip saddr $internal_nets ip daddr $dns_ip meta l4proto { tcp, udp } th dport 53 accept

    # Centralized Rsyslog collection.
    ip saddr $internal_nets ip daddr $rsyslog_ip meta l4proto { tcp, udp } th dport 514 ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT RSYSLOG "
    ip saddr $internal_nets ip daddr $rsyslog_ip meta l4proto { tcp, udp } th dport 514 accept

    # Internal web service.
    ip saddr $internal_nets ip daddr $web_ip tcp dport { 80, 443 } ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT WEB "
    ip saddr $internal_nets ip daddr $web_ip tcp dport { 80, 443 } accept

    # NFSv4 backup traffic is restricted to the Web server.
    ip saddr $web_ip ip daddr $nfs_ip tcp dport 2049 ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT NFS_BACKUP "
    ip saddr $web_ip ip daddr $nfs_ip tcp dport 2049 accept

    # Ansible keeps ICMP diagnostics; user networks cannot ping critical servers.
    ip saddr $ansible_ip ip daddr $internal_nets icmp type echo-request accept
    ip saddr $internal_nets ip daddr $critical_servers icmp type echo-request limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_REJECT ICMP_SERVER "
    ip saddr $internal_nets ip daddr $critical_servers icmp type echo-request reject with icmp type admin-prohibited

    # Other internal ICMP remains available for network diagnostics.
    ip saddr $internal_nets ip daddr $internal_nets ip protocol icmp accept

    # Internal networks may access the Internet through the WAN interface.
    ip saddr $internal_nets oifname $wan_if ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT WAN "
    ip saddr $internal_nets oifname $wan_if accept

    # Publish the intranet through the firewall WAN address.
{% if firewall_publish_web_on_wan %}
    iifname $wan_if ip daddr $web_ip tcp dport { {{ firewall_external_web_ports | join(', ') }} } ct state new limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_ACCEPT EXT_WEB "
    iifname $wan_if ip daddr $web_ip tcp dport { {{ firewall_external_web_ports | join(', ') }} } accept
{% endif %}

    # Reject unauthorized internal forwarding and silently drop unsolicited WAN traffic.
    ip saddr $internal_nets limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_REJECT FORWARD "
    ip saddr $internal_nets reject with icmpx type admin-prohibited

    limit rate {{ firewall_log_rate }} burst {{ firewall_log_burst }} log prefix "NFT_DROP FORWARD "
    drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}

table ip nat {
{% if firewall_publish_web_on_wan %}
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname $wan_if tcp dport 80 dnat to $web_ip:80
    iifname $wan_if tcp dport 443 dnat to $web_ip:443
  }
{% endif %}

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $internal_nets oifname $wan_if masquerade
  }
}
